<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <!-- Persistence Unit para PostgreSQL -->
    <persistence-unit name="postgres1">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>domain.ClienteJpa</class>
        <class>domain.ProdutoJpa</class>
        <class>domain.VendaJpa</class>
        <class>domain.ProdutoQuantidadeJpa</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/vendas_online"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="admin"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

    <persistence-unit name="postgres2">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>domain.ClienteJpa</class>
        <class>domain.ProdutoJpa</class>
        <class>domain.VendaJpa</class>
        <class>domain.ProdutoQuantidadeJpa</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/vendas_online_2"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="admin"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

    <!-- Persistence Unit para MySQL -->
    <persistence-unit name="mysql1">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>domain.ClienteJpa2</class>
        <class>domain.ProdutoJpa</class>
        <class>domain.VendaJpa</class>
        <class>domain.ProdutoQuantidadeJpa</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/vendas_online_mysql"/>
            <property name="jakarta.persistence.jdbc.user" value="admin"/>
            <property name="jakarta.persistence.jdbc.password" value="admin"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>